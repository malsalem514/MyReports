# NextAuth
AUTH_SECRET=replace-with-random-long-secret
NEXTAUTH_URL=http://localhost:3000
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Development auth bypass (optional)
DEV_BYPASS_AUTH=false
DEV_BYPASS_EMAIL=

# Oracle
ORACLE_USER=timelogs
ORACLE_PASSWORD=timelogs
ORACLE_CONNECT_STRING=srv-db-100/suppops

# BigQuery
BIGQUERY_PROJECT_ID=us-activtrak-ac-prod
BIGQUERY_DATASET=672561
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-sa.json
BIGQUERY_QUERY_TIMEOUT_MS=600000
DATA_FRESHNESS_MAX_BUSINESS_DAYS=2

# BambooHR
BAMBOOHR_API_KEY=
BAMBOOHR_SUBDOMAIN=jestais

# Cisco Duo Admin API
DUO_IKEY=
DUO_SKEY=
DUO_HOST=

# Integration timeouts
EXTERNAL_HTTP_TIMEOUT_MS=30000
ORACLE_CALL_TIMEOUT_MS=120000
ORACLE_QUEUE_TIMEOUT_MS=30000

# Scheduler
ENABLE_SCHEDULER=false
SYNC_DAYS_BACK=112
